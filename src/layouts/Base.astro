---
import '../styles/global.css';
import { SITE_NAME, SITE_DESC, HOME_TITLE, withBase, ADSENSE_CLIENT, ADSENSE_ENABLED } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  /** 소셜 공유 타입. 기법 상세 글은 'article'. */
  ogType?: 'website' | 'article';
  /** 검색엔진 색인 제외 (개인 학습 데이터 페이지 등) */
  noindex?: boolean;
  /** 구조화 데이터(JSON-LD) 객체 */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE_DESC,
  active = '',
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : HOME_TITLE;

// 정규 URL — 중복 색인을 막는다
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site ?? 'https://jusikgongbu.org').href;

const nav = [
  { href: '/', key: 'home', label: '전체 기법' },
  { href: '/my', key: 'my', label: '내 학습' },
  { href: '/about', key: 'about', label: '소개' },
];
---

{/* AdSense 로더 — 게시자 ID가 설정된 경우에만 삽입된다 */}

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* 소셜 공유 미리보기 (카카오톡·트위터·페이스북 등) */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? 'https://jusikgongbu.org').href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site ?? 'https://jusikgongbu.org').href} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <link
      rel="icon"
      href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📈</text></svg>`}
    />
    {ADSENSE_ENABLED && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    )}
    <script is:inline>
      // 테마 초기화 (FOUC 방지를 위해 head에서 즉시 실행)
      (() => {
        const saved = localStorage.getItem('sp:theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a class="site-logo" href={withBase('/')}>
          <span class="mark">📈</span>
          <span>{SITE_NAME}</span>
        </a>
        <nav class="site-nav" aria-label="주 메뉴">
          {nav.map((item) => (
            <a
              href={withBase(item.href)}
              aria-current={active === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <button class="theme-toggle" id="theme-toggle" aria-label="다크 모드 전환" title="다크 모드 전환">
            <span aria-hidden="true">◐</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>
          <b>{SITE_NAME}</b> — 매매 기법 학습 라이브러리
          <a class="foot-link" href={withBase('/privacy')}>개인정보처리방침</a>
        </span>
        <span>
          이 사이트의 모든 내용은 교육 목적으로 정리된 자료이며, 특정 종목의 매수·매도 추천이나
          투자 자문이 아닙니다. 투자의 책임은 투자자 본인에게 있습니다.
        </span>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('sp:theme', next);
      });
    </script>
  </body>
</html>
